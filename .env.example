# These variables are read from the process environment; never commit real secrets.
MEDIAFORGE_DATA=~/.mediaforge
MEDIAFORGE_HOST=127.0.0.1
MEDIAFORGE_PORT=18081
MEDIAFORGE_CONCURRENCY=2
MEDIAFORGE_MAX_FILE_BYTES=536870912
MEDIAFORGE_QUOTA_BYTES=10737418240
MEDIAFORGE_MAX_PENDING=100
MEDIAFORGE_TIMEOUT=1800
MEDIAFORGE_RETENTION_DAYS=7
MEDIAFORGE_SECURE_COOKIE=0
MEDIAFORGE_COOKIE_PATH=/
# Production uses a Unix socket behind TLS; see deployment documentation.
# MEDIAFORGE_UNIX_SOCKET=/run/mediaforge/api.sock
# MEDIAFORGE_PUBLIC_URL=https://107.151.245.166:18081
# MEDIAFORGE_RELEASE_FILE=/opt/mediaforge/current/release.json
# MEDIAFORGE_ASR_MODEL=/opt/mediaforge/models/faster-whisper-small
# U2NET_HOME=/opt/mediaforge/models/u2net
# MEDIAFORGE_FONT=/path/to/cjk-font.ttc
# Client/MCP only:
# MEDIAFORGE_URL=https://107.151.245.166:18081/mediaforge
# MEDIAFORGE_TOKEN_FILE=/secure/path/workspace.token
# MEDIAFORGE_LOCAL_ROOTS=/authorized/inputs
# MEDIAFORGE_OUTPUT_ROOTS=/authorized/outputs
