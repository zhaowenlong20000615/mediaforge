{
  "id": "local.mediaforge",
  "name": "MediaForge 媒体与文档工作台",
  "version": "0.2.6",
  "description": "有工作区授权、真实处理与可恢复任务的本地/自托管媒体工作台",
  "capabilities": [
    "export-results",
    "video-transcode",
    "audio-extract",
    "media-trim",
    "media-merge",
    "media-compress",
    "video-frames",
    "audio-normalize",
    "audio-denoise",
    "subtitle-convert",
    "subtitle-extract",
    "asr",
    "pdf-split",
    "pdf-merge",
    "pdf-rotate",
    "pdf-compress",
    "pdf-images",
    "pdf-text",
    "pdf-word",
    "pdf-ocr",
    "pdf-tables",
    "office-convert",
    "word-replace",
    "image-process",
    "image-crop",
    "image-ocr",
    "image-pdf",
    "image-rename",
    "image-background",
    "image-repair",
    "watermark"
  ],
  "entrypoints": {
    "web": "https://107.151.245.166:18081/mediaforge/",
    "cli": "mediaforge",
    "mcp": "mediaforge mcp",
    "downloads": "https://107.151.245.166:18081/mediaforge/access/#download",
    "install": "https://107.151.245.166:18081/mediaforge/access/#install",
    "cli_docs": "https://107.151.245.166:18081/mediaforge/access/#cli",
    "mcp_docs": "https://107.151.245.166:18081/mediaforge/access/#mcp",
    "skill": "https://107.151.245.166:18081/mediaforge/access/#skill",
    "skill_docs": "https://107.151.245.166:18081/mediaforge/access/#skill",
    "local_engine_install": "https://107.151.245.166:18081/mediaforge/access/#install"
  },
  "docs": {
    "quickstart": "README.md",
    "skill": "skill/SKILL.md",
    "installation": "docs/DEPLOYMENT.md",
    "models": "docs/MODELS.md"
  },
  "permissions": [
    "authorized_file_upload",
    "workspace_scoped_tasks",
    "workspace_scoped_download",
    "explicit_retention_cleanup"
  ],
  "platforms": [
    "macOS arm64",
    "Linux x86_64"
  ],
  "auth": {
    "mode": "workspace_token_or_http_only_session",
    "remote_tls_required": true
  },
  "health": {
    "endpoint": "/healthz",
    "readiness": "/readyz",
    "version": "/version",
    "capabilities": "/api/doctor"
  },
  "repository": "https://github.com/zhaowenlong20000615/mediaforge",
  "contact": "https://github.com/zhaowenlong20000615/mediaforge/issues",
  "dependencies": [
    "FFmpeg/FFprobe",
    "Poppler",
    "Tesseract + language packs",
    "LibreOffice",
    "Python packages in uv.lock",
    "Optional preconfigured Faster Whisper/U²-Net models",
    "OCRmyPDF 17 (preserve existing PDF text)",
    "filetype (content-based media identification)"
  ],
  "limitations": [
    "PDF→Word defaults to editable layout with a rendered PDF preview; complex columns, formulas and borderless tables require review",
    "Image subtitles require a separate OCR workflow",
    "Animated images process the first frame",
    "OCR/ASR/table extraction/repair quality requires review",
    "CUDA and Windows not validated",
    "No integrated virus scanner; trusted-user self-hosting only"
  ],
  "updates": "CHANGELOG.md",
  "installation": "Install uv dependencies, start service, obtain workspace token, configure CLI/MCP and load project Skill manually."
}
